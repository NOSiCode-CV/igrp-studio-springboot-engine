    "Spring",
    "Engine",
    "TypeScript",
    "Handlebars",
    "API",
    "API-Rest"
  ],
  "author": "Marcelo Monteiro - NOSi",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "fs-extra": "^11.2.0",
    "sass": "^1.77.8",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "fast-xml-parser": "^4.3.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.11",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
