{
  "name": "@igrp/igrp-studio-springboot-engine",
  "version": "0.1.0-beta.12",
  "description": "Spring Boot API Creation Engine",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "custom": {
    "igrpVersion": "0.1.0-beta.1",
    "javaVersion": "25",
    "springBootVersion": "3.5.8",
    "springCloudVersion": "2025.0.0",
    "springDocVersion": "2.8.14"
  },
  "scripts": {
    "test": "jest",
    "build": "env-cmd -f .env.production tsc && vite build",
    "start": "tsc && vite",
    "deploy": "npm publish --registry=https://sonatype.nosi.cv/repository/igrp/ --tag latest",
    "release": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOSiCode-CV/igrp-studio-springboot-engine.git"
  },
  "keywords": [
    "Spring",
    "Engine",
    "TypeScript",
    "Handlebars",
    "API",
    "API-Rest"
  ],
  "author": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.2",
    "fast-xml-parser": "^5.3.2",
    "fs-extra": "^11.3.2",
    "inflection": "^3.0.2",
    "sass": "^1.94.2",
    "pluralize": "^8.0.0",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/pluralize": "^0.0.33",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "handlebars": "^4.7.8",
    "jest": "^30.2.0",
    "prettier": "^3.7.1",
    "ts-jest": "^29.4.5",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "type": "commonjs",
  "exports": {
    "./types": {
      "import": "./dist/interfaces/types.d.ts"
    },
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  }
}