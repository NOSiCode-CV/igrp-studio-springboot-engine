{
  "compilerOptions": {
    "target": "ESNext",        
    "module": "ESNext",
    "lib": ["ESNext"],     
    "outDir": "./dist",  
    "moduleResolution": "bundler",
    "rootDir": "./src",       
    "strict": true,           
    "esModuleInterop": true,   
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src"]  ,
  "exclude": ["src/**/__docs__", "src/test"]        
}
