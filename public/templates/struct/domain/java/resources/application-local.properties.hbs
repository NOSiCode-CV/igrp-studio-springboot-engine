spring.application.name={{baseConfig.name}}

######## Actuator Configuration  #########
management.info.git.mode=full
management.endpoints.web.exposure.include=*
management.metrics.tags.application=${spring.application.name}
management.tracing.enabled=false
management.tracing.sampling.probability=1.0

# Datasource
spring.datasource.url={{#if (eq baseConfig.database "Postgresql")}}jdbc:postgresql://localhost:${POSTGRES_INTERNAL_PORT}/${POSTGRES_DATABASE}{{else if (eq baseConfig.database "MySQL")}}jdbc:mysql://localhost:${MYSQL_INTERNAL_PORT}/${MYSQL_DATABASE}{{else if (eq baseConfig.database "Oracle")}}jdbc:oracle:thin:@localhost:${ORACLE_INTERNAL_PORT}:${ORACLE_DATABASE}{{/if}}
spring.datasource.username={{#if (eq baseConfig.database "Postgresql")}}${POSTGRES_USER}{{else if (eq baseConfig.database "MySQL")}}${MYSQL_USER}{{else if (eq baseConfig.database "Oracle")}}${ORACLE_USER}{{/if}}
spring.datasource.password={{#if (eq baseConfig.database "Postgresql")}}${POSTGRES_PASSWORD}{{else if (eq baseConfig.database "MySQL")}}${MYSQL_PASSWORD}{{else if (eq baseConfig.database "Oracle")}}${ORACLE_PASSWORD}{{/if}}
spring.datasource.driver-class-name={{#if (eq baseConfig.database "Postgresql")}}org.postgresql.Driver{{else if (eq baseConfig.database "MySQL")}}com.mysql.cj.jdbc.Driver{{else if (eq baseConfig.database "Oracle")}}oracle.jdbc.OracleDriver{{/if}}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.{{#if (eq baseConfig.database "Postgresql")}}PostgreSQLDialect{{else if (eq baseConfig.database "MySQL")}}MySQL8Dialect{{else if (eq baseConfig.database "Oracle")}}Oracle12cDialect{{/if}}