{{> package-java }}

import {{baseConfig.group}}.{{baseConfig.artifact}}.infrastructure.db.converter.Converter;
import {{baseConfig.group}}.{{baseConfig.artifact}}.infrastructure.db.dataobject.{{toLowerCase resourceConfig.aggregate}}.{{resourceConfig.name}}DO;
import {{baseConfig.group}}.{{baseConfig.artifact}}.infrastructure.db.entity.{{toLowerCase resourceConfig.aggregate}}.{{resourceConfig.name}}Entity;
import org.springframework.stereotype.Component;

@Component
public class {{resourceConfig.name}}Converter implements Converter<{{resourceConfig.name}}Entity, {{resourceConfig.name}}DO> {

   @Override
   public {{resourceConfig.name}}DO serialize({{resourceConfig.name}}Entity t) {
      return new {{resourceConfig.name}}DO(
      {{#each resourceConfig.attributes}}
        t.get{{capitalize this.name}}(){{#unless @last}}, {{/unless}}
      {{/each}}
      );
   }

   @Override
   public {{resourceConfig.name}}Entity deserialize({{resourceConfig.name}}DO r) {
      return new {{resourceConfig.name}}Entity(
      {{#each resourceConfig.attributes}}
        r.get{{capitalize this.name}}{{#unless @last}}, {{/unless}}
      {{/each}}
      );
   }

}