import {{baseConfig.group}}.{{baseConfig.packageName}}.application.command.Command;

{{> lombok-java-imports}}
{{{resolve-imports resourceConfig baseConfig}}}
{{#if resourceConfig.attributes.length}}
  {{> lombok-java-annotations}}
