    @Override
    public {{resourceConfig.name}}AggregateDTO {{toCamelCase resourceConfig.name}}AggregateQuery({{keyType resourceConfig}} id) {
        return aggregateRepository.findById(id)
                .map(aggregateAssembler::apply)
                .orElseThrow(() -> new Exception("No aggregate found with id " + id));
    }

    @Override
    public List<{{resourceConfig.name}}AggregateDTO> {{toCamelCase resourceConfig.name}}AggregatesQuery(List<{{keyType resourceConfig}}> ids) {
        return aggregateRepository.findAllById(ids)
                .map(aggregateAssembler::apply)
                .orElseThrow(() -> new Exception("No aggregate found with id " + id));
    }

