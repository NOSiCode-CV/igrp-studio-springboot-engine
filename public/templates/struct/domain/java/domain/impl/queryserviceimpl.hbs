package {{baseConfig.group}}.{{baseConfig.artifact}}.domain.impl.{{toLowerCase resourceConfig.name}};

import {{baseConfig.group}}.{{baseConfig.artifact}}.application.query.assembler.{{resourceConfig.name}}Assembler;
import {{baseConfig.group}}.{{baseConfig.artifact}}.application.query.assembler.{{resourceConfig.name}}AggregateAssembler;
import {{baseConfig.group}}.{{baseConfig.artifact}}.application.query.dto.{{resourceConfig.name}}DTO;
