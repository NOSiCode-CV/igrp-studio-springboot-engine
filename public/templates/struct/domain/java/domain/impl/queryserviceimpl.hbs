@Service
public class {{resourceConfig.name}}QueryServiceImpl implements {{resourceConfig.name}}QueryService {

    private final {{resourceConfig.name}}Repository repository;
    private final {{resourceConfig.name}}AggregateDomainRepository aggregateRepository;
    private final {{resourceConfig.name}}Assembler assembler;
    private final {{resourceConfig.name}}AggregateAssembler aggregateAssembler;
    private final {{resourceConfig.name}}Converter converter;

    public {{resourceConfig.name}}QueryServiceImpl(
        {{resourceConfig.name}}Repository repository,
        {{resourceConfig.name}}AggregateDomainRepository aggregateRepository,
        {{resourceConfig.name}}Assembler assembler,
        {{resourceConfig.name}}AggregateAssembler aggregateAssembler,
        {{resourceConfig.name}}Converter converter
    ) {
        this.repository = repository;
        this.aggregateRepository = aggregateRepository;
        this.assembler = assembler;
        this.aggregateAssembler = aggregateAssembler;
        this.converter = converter;
    }

    @Override
    public List<{{resourceConfig.name}}DTO> query{{resourceConfig.name}}s() {
        return repository.findAll().stream()
                .map(entity -> assembler.apply(converter.serialize(entity)))
                .toList();
    }

    @Override
    public {{resourceConfig.name}}DTO query{{resourceConfig.name}}({{keyType resourceConfig}} id) {
        return assembler.apply(converter.serialize(
                repository.findById(id).orElseThrow(() -> new Exception("No {{toLowerCase resourceConfig.name}} found with id " + id))
        ));
    }

    @Override
    public {{resourceConfig.name}}AggregateDTO query{{resourceConfig.name}}Aggregate({{keyType resourceConfig}} id) {
        return aggregateRepository.findById(id)
                .map(aggregateAssembler::apply)
                .orElseThrow(() -> new Exception("No aggregate found with id " + id));
    }
}