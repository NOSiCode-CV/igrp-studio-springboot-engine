{{> package-java }}

import {{baseConfig.group}}.{{baseConfig.packageName}}.domain.aggregate.ValueObject;

{{> lombok-java-imports}}

{{{resolve-imports resourceConfig baseConfig basePath}}}

{{> lombok-java-annotations}}
{{#each resourceConfig.annotations}}
  @{{this.annotation}}
{{/each}}
public class {{resourceConfig.name}}ValueObject implements ValueObject {

  {{#each resourceConfig.attributes}}
    {{#each this.annotations}}
      @{{this.annotation}}
    {{/each}}
    private {{{resolve-type this}}} {{this.name}};
  {{/each}}

}