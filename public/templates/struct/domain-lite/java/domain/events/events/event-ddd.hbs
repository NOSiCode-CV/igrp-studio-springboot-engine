{{> package-java }}

{{#if resourceConfig.attributes}}
{{> lombok-java-imports}}
{{/if}}
{{{resolve-imports resourceConfig baseConfig}}}

{{#if resourceConfig.attributes}}
{{> lombok-java-annotations}}
{{/if}}
{{#each resourceConfig.annotations}}
  @{{this.annotation}}
{{/each}}
public class {{resourceConfig.name}}Event {

{{#each resourceConfig.attributes}}
  {{#each this.annotations}}
  @{{this.annotation}}
  {{/each}}
  {{{resolve-annotations this}}}
  private {{{resolve-type this}}} {{this.name}};

{{/each}}
}