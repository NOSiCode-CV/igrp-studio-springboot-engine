    consumes = "{{this.accepts}}" {{/if}}{{#if this.contentType}},
    produces = "{{this.contentType}}"{{/if}}
  )
  public ResponseEntity<{{cleanStr response}}> {{toCamelCase actionName}}({{#if requestBody}}@RequestBody {{#ifNot (eq method "GET")}}{{capitalize actionName}}Command {{toCamelCase actionName}}Command{{else}}{{this.requestBody}} {{toCamelCase this.requestBody}}{{/ifNot}}{{/if}}{{#if requestBody}}{{#if requestParams}}, {{/if}}{{/if}}{{#each requestParams}}@RequestParam {{this.type}} {{this.name}}{{#if @last}}{{else}}, {{/if}}{{/each}}{{#if requestParams}}{{#if pathVariables}}, {{/if}}{{/if}}{{#each pathVariables}}@PathVariable {{this.type}} {{this.name}}{{#if @last}}{{else}},{{/if}}{{/each}}) {

