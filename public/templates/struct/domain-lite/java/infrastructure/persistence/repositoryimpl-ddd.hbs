{{> package-java }}

import {{baseConfig.group}}.{{baseConfig.packageName}}.{{#if resourceConfig.module}}{{toLowerCase resourceConfig.module}}{{else}}shared{{/if}}.infrastructure.persistence.entity.{{capitalize resourceConfig.name}};
import {{baseConfig.group}}.{{baseConfig.packageName}}.shared.domain.exceptions.IgrpResponseStatusException;
import org.springframework.stereotype.Repository;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.JpaSpecificationExecutor;
import org.springframework.http.HttpStatus;
{{#if resourceConfig.crud}}
import org.springframework.data.rest.core.annotation.RepositoryRestResource;
import org.springframework.data.rest.core.annotation.RestResource;
{{/if}}
{{#if resourceConfig.crud.disabledMethods}}{{else}}import java.util.Optional;{{/if}}
{{import-uuid resourceConfig}}
{{#if resourceConfig.revision~}} import org.springframework.data.repository.history.RevisionRepository;{{~/if}}

@Repository
{{#if resourceConfig.crud}}
@RepositoryRestResource(path = "{{toCamelCase resourceConfig.name}}")
{{/if}}
public interface {{capitalizeJavaStyle resourceConfig.name}}Repository extends
    JpaRepository<{{resourceConfig.name}}, {{keyType resourceConfig}}>,
    JpaSpecificationExecutor<{{resourceConfig.name}}>{{#if resourceConfig.revision ~}},
    RevisionRepository<{{resourceConfig.name}}, {{keyType resourceConfig}}, Integer> {{~/if}}
{

      default {{resourceConfig.name}} findByIdOrThrow({{keyType resourceConfig}} id) {
          return this.findById(id)
          .orElseThrow(() -> IgrpResponseStatusException.of(HttpStatus.NOT_FOUND,"{{resourceConfig.name}} not found for id: " + id));
      }

  {{#if resourceConfig.crud.disabledMethods}}
  {{#each resourceConfig.crud.disabledMethods}}
  {{#if (eq this 'save')}}
  @Override
  @RestResource(exported = false)
  <S extends {{../resourceConfig.name}}> S save(S entity);
  {{else if (eq this 'deleteById')}}
  @Override
  @RestResource(exported = false)
  void deleteById({{keyType ../resourceConfig}} id);
  {{else if (eq this 'delete')}}
  @Override
  @RestResource(exported = false)
  void delete({{../resourceConfig.name}} entity);
  {{else if (eq this 'deleteAll')}}
  @Override
  @RestResource(exported = false)
  void deleteAll();
  {{else if (eq this 'deleteAllList')}}
  @Override
  @RestResource(exported = false)
  void deleteAll(List<? extends {{../resourceConfig.name}}> entities);
  {{else if (eq this 'findAll')}}
  @Override
  @RestResource(exported = false)
  List<{{../resourceConfig.name}}> findAll();
  {{else if (eq this 'findById')}}
  @Override
  @RestResource(exported = false)
  Optional<{{../resourceConfig.name}}> findById({{keyType ../resourceConfig}} id);
  {{else if (eq this 'findAllById')}}
  @Override
  @RestResource(exported = false)
  List<{{../resourceConfig.name}}> findAllById(List<{{keyType resourceConfig}}> ids);
  {{/if}}

  {{/each}}
  {{/if}}
}