{{> package-java }}

import jakarta.validation.*;
import jakarta.validation.constraints.*;
{{> lombok-java-imports}}

{{{resolve-imports resourceConfig}}}

{{> lombok-java-annotations}}

{{#each resourceConfig.annotations}}
  @{{this.annotation}}
{{/each}}

public class {{resourceConfig.name}}DTO {

{{#each resourceConfig.attributes}}
  {{#each this.annotations}}
    @{{this.annotation}}
  {{/each}}
  {{{resolve-annotations this}}}
  private {{{resolve-type this}}} {{this.name}};
{{/each}}

}