# General
spring.config.import=optional:file:.env[.properties]
spring.application.name={{baseConfig.name}}

# Datasource
spring.datasource.url={{#if (eq baseConfig.database "Postgresql")}}jdbc:postgresql://host.docker.internal:${POSTGRES_INTERNAL_PORT}/${POSTGRES_DATABASE}{{else if (eq baseConfig.database "MySQL")}}jdbc:mysql://host.docker.internal:${MYSQL_INTERNAL_PORT}/${MYSQL_DATABASE}{{else if (eq baseConfig.database "Oracle")}}jdbc:oracle:thin:@host.docker.internal:${ORACLE_INTERNAL_PORT}:${ORACLE_DATABASE}{{/if}}
spring.datasource.username={{#if (eq baseConfig.database "Postgresql")}}${POSTGRES_USER}{{else if (eq baseConfig.database "MySQL")}}${MYSQL_USER}{{else if (eq baseConfig.database "Oracle")}}${ORACLE_USER}{{/if}}
spring.datasource.password={{#if (eq baseConfig.database "Postgresql")}}${POSTGRES_PASSWORD}{{else if (eq baseConfig.database "MySQL")}}${MYSQL_PASSWORD}{{else if (eq baseConfig.database "Oracle")}}${ORACLE_PASSWORD}{{/if}}
spring.datasource.driver-class-name={{#if (eq baseConfig.database "Postgresql")}}org.postgresql.Driver{{else if (eq baseConfig.database "MySQL")}}com.mysql.cj.jdbc.Driver{{else if (eq baseConfig.database "Oracle")}}oracle.jdbc.OracleDriver{{/if}}

# JPA and Hibernate settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.{{#if (eq baseConfig.database "Postgresql")}}PostgreSQLDialect{{else if (eq baseConfig.database "MySQL")}}MySQLDialect{{else if (eq baseConfig.database "Oracle")}}Oracle12cDialect{{/if}}
# Track entity names modified during a revision
#spring.jpa.properties.org.hibernate.envers.track_entities_changed_in_revision=true
# Enable withModifiedFlag globally
#spring.jpa.properties.org.hibernate.envers.global_with_modified_flag=true
# Set schema and catalog for audit tables
#spring.jpa.properties.org.hibernate.envers.default_schema=audit_schema

# Spring Data REST
spring.data.rest.detection-strategy=annotated

# Authentication
auth.jwt.issuer=${AUTH_JWT_ISSUER}

# Documentation
springdoc.swagger-ui.enabled=${ENABLE_SWAGGER:true}
springdoc.swagger-ui.operationsSorter=method

{{#if baseConfig.enableObservability}}
# Observability
management.info.git.mode=full
management.endpoints.web.exposure.include=*
management.metrics.tags.application=${spring.application.name}
management.tracing.enabled=false
management.tracing.sampling.probability=1.0
{{/if}}