{{> package-java }}

import cv.igrp.framework.stereotype.IgrpController;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.HttpStatus;
import io.swagger.v3.oas.annotations.tags.Tag;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.media.Content;
import io.swagger.v3.oas.annotations.media.Schema;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.media.ExampleObject;
import jakarta.validation.Valid;

{{>controller-imports}}

@IgrpController
@RestController
@RequestMapping(path = "{{resourceConfig.basePath}}")
@Tag(name = "{{capitalize resourceConfig.name}}", description = "{{resourceConfig.description}}")
public class {{capitalize resourceConfig.name}}Controller {

{{>controller-injection}}

{{>controller-constructor}}

{{#each resourceConfig.actions}}
@{{ toTitleCase method}}Mapping({{#if path}}
value = "{{path}}{{#each pathVariables}}/{{paramsFormat this.name}}{{/each}}"{{else}}{{#if pathVariables}}
value = "{{#each pathVariables}}/{{paramsFormat this.name}}{{/each}}" {{/if}}{{/if}}{{#if (and this.headers path)}}{{#if
(containsContentHeader headers)}}, {{/if}}{{/if}}
{{#if headers}}
{{#each headers}}
{{#if (or (eq this.header "Accept") (eq this.header "Content-Type"))}}
{{!-- This is for consumes and produces --}}
{{mapHeaderToOption this}} = "{{this.value}}"{{#if @last}}{{else}}, {{/if}}
{{/if}}
{{/each}}
{{/if}}
)
{{> controller-action-documentation action=this}}
{{> controller-action-definition baseConfig=../baseConfig}}
{{#if (eq ../baseConfig.projectStructureStyle "domain")}}
  {{#if (eq method "GET")}}
    final var query = new {{capitalize actionName}}Query(
    {{#if modelAttribute}}{{toCamelCase modelAttribute}}{{/if}}
    {{#if modelAttribute}}{{#if pathVariables}}, {{/if}}{{/if}}
    {{#each pathVariables}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
    {{#if pathVariables}}{{#if requestParams}}, {{/if}}{{/if}}
    {{#each requestParams}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
    {{#if requestBody}}, {{toCamelCase actionName}}Request{{/if}}
    {{#if (isPageable responses)}}, pageable{{/if}}
    );

    return queryBus.handle(query);
  {{else}}
    final var command = new {{capitalize actionName}}Command(
    {{#if requestBody}}{{toCamelCase actionName}}Request{{/if}}
    {{#if requestBody}}{{#if modelAttribute}}, {{/if}}{{/if}}
    {{#if modelAttribute}}{{toCamelCase modelAttribute}}{{/if}}
    {{#if modelAttribute}}{{#if pathVariables}}, {{/if}}{{/if}}
    {{#each pathVariables}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
    {{#if pathVariables}}{{#if requestParams}}, {{/if}}{{/if}}
    {{#each requestParams}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
    );

    return commandBus.send(command);
  {{/if}}
{{else}}
  return {{toCamelCase ../resourceConfig.name}}Service.{{toCamelCase actionName}}(
  {{#if requestBody}}{{toCamelCase actionName}}Request{{/if}}
  {{#if requestBody}}{{#if modelAttribute}}, {{/if}}{{/if}}
  {{#if modelAttribute}}{{toCamelCase modelAttribute}}{{/if}}
  {{#if modelAttribute}}{{#if pathVariables}}, {{/if}}{{/if}}
  {{#each pathVariables}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
  {{#if pathVariables}}{{#if requestParams}}, {{/if}}{{/if}}
  {{#each requestParams}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
  );
{{/if}}

}

{{/each}}
}