{{> package-java }}

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.HttpStatus;

{{>controller-imports}}

@RestController
@RequestMapping(path = "{{resourceConfig.basePath}}")
public class {{capitalize resourceConfig.name}}Controller {

  {{>controller-injection}}

  {{>controller-constructor}}

  {{#each resourceConfig.actions}}
  @ResponseStatus(HttpStatus.OK)
  @{{ toTitleCase method}}Mapping({{#if path}}
    value = "{{path}}{{#each pathVariables}}/{{paramsFormat this.name}}{{/each}}"{{else}}{{#if (and this.pathVariables path)}}, {{/if}}{{#if pathVariables}}
  value = "{{#each pathVariables}}/{{paramsFormat this.name}}{{/each}}" {{/if}}{{/if}}{{#if (and this.accepts pathVariables)}}, {{/if}}{{#if this.accepts}}
    consumes = "{{this.accepts}}" {{/if}}{{#if (and this.contentType this.accepts)}},{{/if}}{{#if (and this.contentType path)}},{{/if}}{{#if this.contentType}}
    produces = "{{this.contentType}}"{{/if}}
  )
  {{> controller-action-definition baseConfig=../baseConfig}}
  {{#if (eq ../baseConfig.projectStructureStyle "domain")}}
    {{#if (eq method "GET")}}
    {{#if requestParams}}final var query = new {{actionName}}Query({{#if pathVariables}}{{#each pathVariables}}{{this.name}}{{#if @last}}{{#if ../requestParams}}, {{else}}{{/if}}{{else}}, {{/if}}{{/each}}{{/if}}{{#each requestParams}}{{this.name}}{{#if @last}}{{else}}, {{/if}}{{/each}});{{else}}
    final var query = new {{actionName}}Query();
    {{/if}}
    {{else}}
    {{#if requestBody}}{{else if requestParams}}final var command = new {{actionName}}Command({{#if pathVariables}}{{#each pathVariables}}{{this.name}}{{#if @last}}{{#if ../requestParams}}, {{else}}{{/if}}{{else}}, {{/if}}{{/each}}{{/if}}{{#each requestParams}}{{this.name}}{{#if @last}}{{else}}, {{/if}}{{/each}});{{else}}
      final var command = new {{actionName}}Command();
    {{/if}}
    {{/if}}

    {{#if (eq method "GET")}}final var result = {{toCamelCase ../resourceConfig.name}}QueryService.{{toCamelCase actionName}}({{#if requestBody}}{{toCamelCase requestBody}}{{/if}}{{#if requestParams}}query{{else}}query{{/if}});{{else}}final var response = {{toCamelCase ../resourceConfig.name}}CmdService.{{toCamelCase actionName}}({{#if requestBody}}{{toCamelCase actionName}}Command{{else if requestParams}}command{{else}}command{{/if}});{{/if}}

    {{#if (eq method "GET")}}return ResponseEntity.ok(result);{{else}}return ResponseEntity.ok(response);{{/if}}

  {{else}}
    final var result = {{toCamelCase ../resourceConfig.name}}Service.{{toCamelCase actionName}}({{#if requestBody}}{{toCamelCase requestBody}}{{/if}}{{#if (and requestBody requestParams)}}, {{/if}}{{#each requestParams}}{{this.name}}{{#if @last}}{{else}}, {{/if}}{{/each}}{{#if requestParams}}{{#if pathVariables}}, {{/if}}{{/if}}{{#each pathVariables}}{{this.name}}{{#if @last}}{{else}}, {{/if}}{{/each}});

    return ResponseEntity.ok(result);

  {{/if}}
  }
  
  {{/each}}
}