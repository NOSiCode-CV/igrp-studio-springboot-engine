    JpaRepository<{{resourceConfig.name}}, {{keyType resourceConfig}}>,
    JpaSpecificationExecutor<{{resourceConfig.name}}>{{#if resourceConfig.audit}},{{~/if}}
    {{#if resourceConfig.audit~}}RevisionRepository<{{resourceConfig.name}}, {{keyType resourceConfig}}, Integer> {{~/if}}
