spring:
  application:
    name: {{baseConfig.name}}

  profiles:
    active: ${APP_ENVIRONMENT:dev}

  datasource:
    url: {{#if (eq baseConfig.database "Postgresql")}}jdbc:postgresql:{{else if (eq baseConfig.database "MySQL")}}jdbc:mysql:{{else if (eq baseConfig.database "Oracle")}}jdbc:oracle:thin:@{{/if}}//<HOST>:<PORT>/<DATABASE_NAME>?<OPTIONAL_PARAMETERS>
    username: username
    password: password
    driver-class-name: {{#if (eq baseConfig.database "Postgresql")}}org.postgresql.Driver{{else if (eq baseConfig.database "MySQL")}}com.mysql.cj.jdbc.Driver{{else if (eq baseConfig.database "Oracle")}}oracle.jdbc.OracleDriver{{/if}}

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.{{#if (eq baseConfig.database "Postgresql")}}PostgreSQLDialect{{else if (eq baseConfig.database "MySQL")}}MySQL8Dialect{{else if (eq baseConfig.database "Oracle")}}Oracle12cDialect{{/if}}
