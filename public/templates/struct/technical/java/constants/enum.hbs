{{#if resourceConfig.attributes}}
@Getter{{/if}}
public enum {{resourceConfig.name}} {

  {{#each resourceConfig.values}}
  {{toUpperCase this.name}}{{#if this.attributes}}(
    {{#each this.attributes}}
    {{{formatAttribute this}}}{{#unless @last}}, {{/unless}}
    {{/each}}
  ){{/if}}{{#unless @last}},{{/unless}}
  {{/each}};

  {{#if resourceConfig.attributes}}
