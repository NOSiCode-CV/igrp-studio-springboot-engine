package {{baseConfig.group}}.{{baseConfig.packageName}};

{{#if (eq baseConfig.projectStructureStyle "domain")}}
import {{baseConfig.group}}.{{baseConfig.packageName}}.shared.config.ApplicationAuditorAware;
{{else}}
import {{baseConfig.group}}.{{baseConfig.packageName}}.config.ApplicationAuditorAware;
{{/if}}

import org.springframework.boot.SpringApplication;
import org.springframework.context.annotation.Bean;
import org.springframework.data.domain.AuditorAware;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.data.jpa.repository.config.EnableJpaAuditing;

@SpringBootApplication
@EnableJpaAuditing(auditorAwareRef = "auditAware")
public class {{baseConfig.name}}Application {

    @Bean
    public AuditorAware<String> auditAware() {
        return new ApplicationAuditorAware();
    }

    public static void main(String[] args) {
        SpringApplication.run({{baseConfig.name}}Application.class, args);
    }
}