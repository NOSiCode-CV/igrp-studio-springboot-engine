postgres-{{toLowerCase baseConfig.name}}-api-service:
    image: postgres:17-alpine
    container_name: postgres-{{toLowerCase baseConfig.name}}-api-service
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DATABASE}
    ports:
      - ${POSTGRES_PORT}:${POSTGRES_PORT}
    volumes:
      - postgres-data-17-{{toLowerCase baseConfig.name}}-api-service:/var/lib/postgresql/data
    restart: unless-stopped
