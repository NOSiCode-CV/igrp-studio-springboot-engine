mysql-{{toLowerCase baseConfig.name}}-api-service:
    image: mysql:8.0
    container_name: mysql-{{toLowerCase baseConfig.name}}-api-service
    environment:
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    ports:
      - ${MYSQL_PORT}:${MYSQL_PORT}
    volumes:
      - mysql-data-8-{{toLowerCase baseConfig.name}}-api-service:/var/lib/mysql
    restart: unless-stopped