
{{#if (eq baseConfig.database "MySQL")}}
<dependency>
	<groupId>com.mysql</groupId>
	<artifactId>mysql-connector-j</artifactId>
	<scope>runtime</scope>
</dependency>
{{/if}}
{{#if (eq baseConfig.database "Postgresql")}}
<dependency>
	<groupId>org.postgresql</groupId>
	<artifactId>postgresql</artifactId>
	<scope>runtime</scope>
</dependency>
{{/if}}
{{#if (eq baseConfig.database "Oracle")}}
<dependency>
	<groupId>com.oracle.database.jdbc</groupId>
	<artifactId>ojdbc11</artifactId>
	<scope>runtime</scope>
</dependency>
{{/if}}
