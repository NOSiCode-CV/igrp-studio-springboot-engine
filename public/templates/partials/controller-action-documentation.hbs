@Operation(
    summary = "{{method}} method to handle operations for {{actionName}}",
    description = "{{method}} method to handle operations for {{actionName}}"{{#if responses}},
    responses = {
{{#each responses}}
      @ApiResponse(
          responseCode = "{{@key}}",
          description = "{{this.description}}",
          content = @Content(
              {{#each this.content}}
              mediaType = "{{@key}}",
              schema = @Schema(
                  {{#if this.schema.objectType}}
                  implementation = {{this.schema.type}}.class,
                  {{else}}
                  {{#if ../this.name}}
                  implementation = {{normalizeDto ../this.name}}.class,
                  {{/if}}
                  {{/if}}
                  {{#if this.schema.type}}
                  type = "{{this.schema.type}}"{{/if}}{{#if this.schema.description}},
                  description = "{{this.schema.description}}"{{/if}}{{#if this.schema.example}},
                  example = "{{this.schema.example}}"{{/if}}{{#if this.schema.required}},
                  required = true{{/if}}{{#if this.deprecated}},
                  deprecated = true{{/if}}{{#if this.schema.properties}},
                  properties = {
                      {{#each this.schema.properties}}
                      io.swagger.v3.oas.annotations.StringToClassMapItem.@Schema(
                          name = "{{@key}}",
                          type = "{{this.type}}"{{#if this.objectType}},
                          implementation = {{this.type}}.class{{/if}}{{#if this.description}},
                          description = "{{this.description}}"{{/if}}{{#if this.example}},
                          example = "{{this.example}}"{{/if}}{{#if this.pattern}},
                          pattern = "{{this.pattern}}"{{/if}}{{#if this.format}},
                          format = "{{this.format}}"{{/if}}{{#if this.enum}},
                          allowableValues = "{{join this.enum.values ', '}}"{{/if}}{{#if this.deprecated}},
                          deprecated = true{{/if}}{{#if this.minimum}},
                          minimum = {{this.minimum}}{{/if}}{{#if this.maximum}},
                          maximum = {{this.maximum}}{{/if}}{{#if this.pattern}},
                          pattern = "{{this.pattern}}"{{/if}}{{#if this.format}},
                          format = "{{this.format}}"{{/if}}{{#if this.default}},
                          defaultValue = "{{this.default}}"
                          {{/if}}
                      ){{#if @last}}{{else}}, {{/if}}
                      {{/each}}
                  }
                  {{/if}}
              )
              {{/each}}
          )
      ){{#if @last}}{{else}}, {{/if}}
{{/each}}
    }
{{/if}}
)