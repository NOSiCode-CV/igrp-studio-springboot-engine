@Operation(
  summary = "{{method}} method to handle operations for {{normalizeActionNameDocumentation actionName}}",
  description = "{{method}} method to handle operations for {{normalizeActionNameDocumentation actionName}}"{{#if responses}},
  responses = {
{{#each responses}}
    @ApiResponse(
        responseCode = "{{@key}}",
        description = "{{this.description}}",
        content = @Content(
            {{#each this.content}}
            mediaType = "{{@key}}",
            schema = @Schema(
                {{#if (eq this.schema.type "object")}}
                implementation = {{normalizeDto ../this.name}}.class,
                {{else}}
                implementation = {{processImplementation this.schema.type}}.class,
                {{/if}}
                type = "{{processDocumentationType this.schema.type this.schema.objectType}}"{{#if this.schema.description}},
                description = "{{this.schema.description}}"{{/if~}}{{#if this.schema.example}},
                example = "{{this.schema.example}}"{{/if~}}{{#if this.schema.required}},
                required = true{{/if~}}{{#if this.deprecated}},
                deprecated = true{{/if~}}
            )
            {{/each}}
        )
    ){{#if @last}}{{else}}, {{/if}}
{{/each}}
  }
{{/if}}
)
