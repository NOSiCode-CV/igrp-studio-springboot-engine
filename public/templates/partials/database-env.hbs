{{#if (eq baseConfig.database "Postgresql")}}
POSTGRES_HOST=localhost
POSTGRES_VERSION=17-alpine
POSTGRES_SERVICE_NAME={{toLowerCase baseConfig.name}}-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE={{toLowerCase baseConfig.name}}_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
{{else if (eq baseConfig.database "MySQL")}}
MYSQL_SERVICE_NAME={{toLowerCase baseConfig.name}}-mysql
MYSQL_PORT=3306
MYSQL_DATABASE={{toLowerCase baseConfig.name}}_db
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
{{else if (eq baseConfig.database "Oracle")}}
ORACLE_SERVICE_NAME={{toLowerCase baseConfig.name}}-oracle
ORACLE_PORT=1521
ORACLE_DATABASE={{toLowerCase baseConfig.name}}_db
ORACLE_USER=system
ORACLE_PASSWORD=oracle
{{/if}}
