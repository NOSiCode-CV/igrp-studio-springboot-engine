{{#if (eq baseConfig.database "Postgresql")}}
POSTGRES_SERVICE_NAME=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_DATABASE={{toLowerCase baseConfig.name}}_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
{{else if (eq baseConfig.database "MySQL")}}
MYSQL_SERVICE_NAME=mysql
MYSQL_INTERNAL_PORT=3306
MYSQL_EXTERNAL_PORT=3306
MYSQL_DATABASE={{toLowerCase baseConfig.name}}_db
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
{{else if (eq baseConfig.database "Oracle")}}
ORACLE_SERVICE_NAME=oracle
ORACLE_INTERNAL_PORT=1521
ORACLE_EXTERNAL_PORT=1521
ORACLE_DATABASE={{toLowerCase baseConfig.name}}_db
ORACLE_USER=system
ORACLE_PASSWORD=oracle
{{/if}}
