{{#if (eq baseConfig.database "Postgresql")}}
- SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:${POSTGRES_PORT}/${POSTGRES_DATABASE}
- SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
- SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
{{else if (eq baseConfig.database "MySQL")}}
- SPRING_DATASOURCE_URL=jdbc:mysql://mysql:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true
- SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
- SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
{{else if (eq baseConfig.database "Oracle")}}
- SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle:${ORACLE_PORT}:${ORACLE_DATABASE}
- SPRING_DATASOURCE_USERNAME=${ORACLE_USER}
- SPRING_DATASOURCE_PASSWORD=${ORACLE_PASSWORD}
{{/if}}