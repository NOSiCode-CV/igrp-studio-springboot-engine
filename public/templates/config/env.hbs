SERVICE_PROFILE=development
SERVICE_PORT=8080
SERVICE_MEMORY_LIMIT=700m

{{> database-env}}

{{#if (eq baseConfig.database "Postgresql")}}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
{{else if (eq baseConfig.database "MySQL")}}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
{{else if (eq baseConfig.database "Oracle")}}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
{{else if (eq baseConfig.database "H2")}}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
{{/if}}
HIBERNATE_DDL=update
ENABLE_SWAGGER=true

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_WEB=DEBUG
LOGGING_LEVEL_APP=DEBUG

EUREKA_CLIENT_ENABLED=false
SPRING_CLOUD_DISCOVERY_ENABLED=false

AUTH_PROVIDER={{#if (eq baseConfig.authMode "autentika")}}autentika{{else}}keycloak{{/if}}
{{> auth-env}}
IGRP_ACCESS_API_BASE_URL=
