name: "{{toLowerCase baseConfig.name}}"

networks:
  default:
    name: {{toLowerCase baseConfig.name}}
    external: false

services:
  {{#if (eq baseConfig.database "Postgresql")}}
  {{> postgres-docker-service }}
  {{else if (eq baseConfig.database "MySQL")}}
  {{> mysql-docker-service }}
  {{else if (eq baseConfig.database "Oracle")}}
  {{> oracle-docker-service }}
  {{/if}}

  {{toLowerCase baseConfig.name}}-service:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{toLowerCase baseConfig.name}}-service
    env_file:
      - .env
    depends_on:
    {{#if (eq baseConfig.database "Postgresql")}}
      {{toLowerCase baseConfig.name}}-postgres:
        condition: service_healthy
    {{else if (eq baseConfig.database "MySQL")}}
      {{toLowerCase baseConfig.name}}-mysql:
        condition: service_started
    {{else if (eq baseConfig.database "Oracle")}}
      {{toLowerCase baseConfig.name}}-oracle:
        condition: service_started
    {{/if}}
    environment:
      - SERVER_PORT=${SERVICE_PORT}
      - SPRING_PROFILES_ACTIVE=${SERVICE_PROFILE}
      {{> database-docker-env }}
      - SPRING_DATASOURCE_DRIVER_CLASS_NAME=${SPRING_DATASOURCE_DRIVER_CLASS_NAME}
      - AUTH_JWT_ISSUER=${AUTH_JWT_ISSUER}
      - IGRP_ACCESS_API_BASE_URL=${IGRP_ACCESS_API_BASE_URL}
      - ENABLE_SWAGGER=${ENABLE_SWAGGER}
      - EUREKA_CLIENT_ENABLED=${EUREKA_CLIENT_ENABLED}
      - SPRING_CLOUD_DISCOVERY_ENABLED=${SPRING_CLOUD_DISCOVERY_ENABLED}
      - LOGGING_LEVEL_ROOT=${LOGGING_LEVEL_ROOT}
      - LOGGING_LEVEL_SPRING_WEB=${LOGGING_LEVEL_SPRING_WEB}
      - LOGGING_LEVEL_APP=${LOGGING_LEVEL_APP}
      - SPRING_JPA_HIBERNATE_DDL_AUTO=${HIBERNATE_DDL}
      - IGRP_WORKSPACE_SLUG=${IGRP_WORKSPACE_SLUG}
      - IGRP_WORKSPACE_ID=${IGRP_WORKSPACE_ID}
    ports:
      - "${SERVICE_PORT}:8080"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: ${SERVICE_MEMORY_LIMIT}

volumes:
  {{> database-docker-volumes }}
