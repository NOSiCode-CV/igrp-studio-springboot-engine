<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>{{baseConfig.group}}</groupId>
	<artifactId>{{baseConfig.artifact}}</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>{{baseConfig.apiName}}</name>
	<description>{{baseConfig.description}}</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
  <repositories>
    <repository>
      <id>igrp-framework-releases</id>
      <url>https://sonatype.nosi.cv/repository/igrp-framework-releases/</url>
    </repository>
  </repositories>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		{{> spring-maven-dependencies}}
		{{> spring-entity-revision-dependencies}}
		{{> database-maven-dependencies}}
		{{> security-maven-dependencies}}
		{{> oauth-maven-dependencies}}
		{{> generic-maven-dependencies}}
		{{> observability-maven-dependencies}}
		{{> igrp-maven-dependencies}}
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>