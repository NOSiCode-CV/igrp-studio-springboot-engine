###### DEV PIPELINE ######
image: docker:27.3.1
services:
  - name: docker:27.3.1-dind
    command: [ "--tls=false", "--mtu=1240" ]

variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: ""
  DOCKER_HOST: tcp://docker:2375
  KUBECONFIG: "/kube/config"
  KUBE_NAMESPACE: "p2" # Valor por defecto para el namespace, pero configurable en el pipeline
  API_URL: "https://user-manager-dev.inss.gw/identity/resources" # Valor por defecto de la API, pero configurable en el pipeline
  APPLICATION_NAME: "application-1"  # Valor por defecto, pero configurable en el pipeline
  HOME_URL: "wayvant-test.com/" # Valor por defecto, pero configurable en el pipeline
  RESOURCE_NAME: "p2" # Valor por defecto, pero configurable en el pipeline
  RESOURCE_DESCRIPTION: "staff 1" # Valor por defecto, pero configurable en el pipeline
stages:
  - setup
  - build
  - deploy
  - buildjson
  - deployjson

setup:
  stage: setup
  image: alpine:latest
  script:
    - |
      echo "Configurando el entorno..."
      # Esto es un ejemplo, pero la idea es leer variables que vengan del usuario (ej. $CUSTOM_KUBE_NAMESPACE)
      # Si el usuario no define una variable, se usa el valor por defecto
      export KUBE_NAMESPACE_FINAL="${CUSTOM_KUBE_NAMESPACE:-$KUBE_NAMESPACE}"
      export API_URL_FINAL="${CUSTOM_API_URL:-$API_URL}"
      export APPLICATION_NAME_FINAL="${CUSTOM_APPLICATION_NAME:-$APPLICATION_NAME}"
      export HOME_URL_FINAL="${CUSTOM_HOME_URL:-$HOME_URL}"
      export RESOURCE_NAME_FINAL="${CUSTOM_RESOURCE_NAME:-$RESOURCE_NAME}"
      export RESOURCE_DESCRIPTION_FINAL="${CUSTOM_RESOURCE_DESCRIPTION:-$RESOURCE_DESCRIPTION}"

      # Leemos el contenido del archivo paths.json
      export PATHS_JSON=$(cat paths.json)

      echo "KUBE_NAMESPACE_FINAL: $KUBE_NAMESPACE_FINAL"
      echo "API_URL_FINAL: $API_URL_FINAL"
      echo "APPLICATION_NAME_FINAL: $APPLICATION_NAME_FINAL"
      echo "HOME_URL_FINAL: $HOME_URL_FINAL"
      echo "RESOURCE_NAME_FINAL: $RESOURCE_NAME_FINAL"
      echo "RESOURCE_DESCRIPTION_FINAL: $RESOURCE_DESCRIPTION_FINAL"
      echo "PATHS_JSON: $PATHS_JSON" # Verificamos que el contenido se cargó correctamente

      # Estas variables finales se usarán en los stages siguientes.
      TMP_FILE=$(mktemp)
      printf 'KUBE_NAMESPACE_FINAL="%s"\n' "$KUBE_NAMESPACE_FINAL" >> "$TMP_FILE"
      printf 'API_URL_FINAL="%s"\n' "$API_URL_FINAL" >> "$TMP_FILE"
      printf 'APPLICATION_NAME_FINAL="%s"\n' "$APPLICATION_NAME_FINAL" >> "$TMP_FILE"
      printf 'HOME_URL_FINAL="%s"\n' "$HOME_URL_FINAL" >> "$TMP_FILE"
      printf 'RESOURCE_NAME_FINAL="%s"\n' "$RESOURCE_NAME_FINAL" >> "$TMP_FILE"
      printf 'RESOURCE_DESCRIPTION_FINAL="%s"\n' "$RESOURCE_DESCRIPTION_FINAL" >> "$TMP_FILE"
      printf 'PATHS_JSON="%s"\n' "$PATHS_JSON" >> "$TMP_FILE"  # Guardamos la variable en el archivo variables.env
      
      cat "$TMP_FILE" > variables.env # Sustituye el contenido
      rm "$TMP_FILE"
  artifacts:
    paths:
      - variables.env

build:
  stage: build
  only:
    - dev
  script:
    - source variables.env
    - docker login $REGISTRY_URL -u "$REGISTRY_USERNAME" -p "$REGISTRY_PASSWORD"
    - docker build -t $REGISTRY_URL/$REGISTRY_PROJECT/igrp-studio:$CI_PIPELINE_ID .
    - docker tag $REGISTRY_URL/$REGISTRY_PROJECT/igrp-studio:$CI_PIPELINE_ID $REGISTRY_URL/$REGISTRY_PROJECT/igrp-studio:$RESOURCE_NAME_FINAL
    - docker push $REGISTRY_URL/$REGISTRY_PROJECT/igrp-studio:$CI_PIPELINE_ID
    - docker push $REGISTRY_URL/$REGISTRY_PROJECT/igrp-studio:$RESOURCE_NAME_FINAL

deploy:
  stage: deploy
  image: bitnami/kubectl:latest
  needs: [setup]
  script:
    - source variables.env
    - apk add --no-cache gettext # Instala gettext
    - echo "$KUBECONFIG_CONTENT" > $KUBECONFIG
    - envsubst < ./k8s/deployment.yaml > ./k8s/deployment-substituted.yaml # Sustituye todas las variables
    - kubectl apply -f ./k8s/deployment-substituted.yaml -n $KUBE_NAMESPACE_FINAL
    - kubectl rollout status deployment/igrp-studio -n $KUBE_NAMESPACE_FINAL
  only:
    - dev

build_json:
  stage: buildjson
  image: alpine/curl
  needs: [setup]
  script:
    - source variables.env
    - apk add jq
    - |
      PATHS="$PATHS_JSON"
      echo "Paths obtenidos: ${PATHS}"

      JSON_PAYLOAD=$(jq -n \
        --arg application "$APPLICATION_NAME_FINAL" \
        --arg homeUrl "$HOME_URL_FINAL" \
        --arg name "$RESOURCE_NAME_FINAL" \
        --arg description "$RESOURCE_DESCRIPTION_FINAL" \
        --argjson endpoints "$PATHS" \
        '{
            application: $application,
            homeUrl: $homeUrl,
            name: $name,
            description: $description,
            endpoints: $endpoints
        }'
      )
      echo "JSON a enviar:"
      echo "${JSON_PAYLOAD}"
      echo "${JSON_PAYLOAD}" > payload.json
  artifacts:
    paths:
      - payload.json
  only:
    - dev

deploy_resource:
  stage: deployjson
  image: alpine/curl
  needs: [build_json, setup] # dependecia del stage setup
  script:
    - source variables.env
    - |
      curl -X POST \
        -H "Content-Type: application/json" \
        -d @payload.json \
        "$API_URL_FINAL"
  only:
    - dev

