image: docker:27.3.1
services:
  - name: docker:27.3.1-dind
    alias: docker
    command: ["--tls=false", "--mtu=1240"]
variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: ""
  DOCKER_HOST: tcp://docker:2375
  REGISTRY_URL: "registry.nosi.cv"
  REGISTRY_PROJECT: "{{#if baseConfig.workspaceSlug}}{{baseConfig.workspaceSlug}}{{else}}workspace{{/if}}"
  IMAGE_NAME: "{{toLowerCase baseConfig.name}}"

stages:
  - build

build_docker_image_dev:
  stage: build
  only:
    - main
  script:
    - docker login $REGISTRY_URL -u "$REGISTRY_USERNAME" -p "$REGISTRY_PASSWORD"
    - docker build -t $REGISTRY_URL/$REGISTRY_PROJECT/$IMAGE_NAME:$CI_PIPELINE_ID .
    - docker tag $REGISTRY_URL/$REGISTRY_PROJECT/$IMAGE_NAME:$CI_PIPELINE_ID $REGISTRY_URL/$REGISTRY_PROJECT/$IMAGE_NAME:latest
    - docker push $REGISTRY_URL/$REGISTRY_PROJECT/$IMAGE_NAME:$CI_PIPELINE_ID
    - docker push $REGISTRY_URL/$REGISTRY_PROJECT/$IMAGE_NAME:latest
