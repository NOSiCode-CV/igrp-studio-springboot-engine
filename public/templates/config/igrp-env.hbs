TARGET_DATABASE={{toLowerCase baseConfig.name}}_db
SPRING_DATASOURCE_URL=jdbc:postgresql://{{#if baseConfig.workspaceSlug}}{{baseConfig.workspaceSlug}}{{else}}workspace{{/if}}-database-postgres:5432/{{toLowerCase baseConfig.name}}_db
SPRING_PROFILES_ACTIVE=development
ENABLE_SWAGGER=true
SPRINGDOC_SWAGGER_UI_DISABLE_SWAGGER_DEFAULT_URL=true
SPRINGDOC_SWAGGER_UI_URL=/gateway-api/{{toLowerCase baseConfig.name}}/v3/api-docs
SPRINGDOC_SWAGGER_UI_CONFIG_URL=/gateway-api/{{toLowerCase baseConfig.name}}/v3/api-docs/swagger-config
OPENAPI_SERVER_API=http://${DOCKER_IP}:${NGINX_HTTP_PORT}/gateway-api/{{toLowerCase baseConfig.name}}
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_WEB=DEBUG
LOGGING_LEVEL_APP=DEBUG
{{> observability-env}}
IGRP_ACCESS_M2M_SYNC_TOKEN=igrp-access-m2m-sync-token-1234
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
