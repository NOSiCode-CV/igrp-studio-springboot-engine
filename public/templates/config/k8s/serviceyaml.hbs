apiVersion: v1
kind: Service
metadata:
  name: {{toLowerCase baseConfig.name}}-service
  labels:
    app: {{toLowerCase baseConfig.name}}
    gateway.expose: "true"
    gateway.name: {{#if baseConfig.workspaceSlug}}{{baseConfig.workspaceSlug}}{{else}}workspace{{/if}}
spec:
  selector:
    app: {{toLowerCase baseConfig.name}}
  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080
  type: ClusterIP
